{
  "name": "zhusha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @zhusha/web dev",
    "build": "pnpm --filter @zhusha/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:deno": "deno check packages/core/src/index.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "gen:types": "supabase gen types typescript > packages/shared-types/src/database.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
